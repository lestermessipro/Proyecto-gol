+package net.sports.kit.client;
+
+import java.awt.image.BufferedImage;
+import java.io.InputStream;
+import javax.imageio.ImageIO;
+import net.minecraft.item.Item;
+import net.minecraft.item.ItemStack;
+import net.minecraft.util.ResourceLocation;
+import net.sports.kit.KitRegistrar;
+import org.junit.After;
+import org.junit.Before;
+import org.junit.Test;
+import static org.junit.Assert.*;
+
+public class ClubCrestsTest {
+    private Item[] originals;
+
+    @Before public void setUp() {
+        net.minecraft.init.Bootstrap.register();
+        originals = KitRegistrar.JERSEYS.clone();
+        for (int i = 0; i < KitRegistrar.JERSEYS.length; i++) KitRegistrar.JERSEYS[i] = new Item();
+    }
+
+    @After public void restoreItems() {
+        System.arraycopy(originals, 0, KitRegistrar.JERSEYS, 0, originals.length);
+    }
+
+    @Test public void eachClubJerseySelectsItsOwnCrest() {
+        for (String team : new String[]{"barcelona", "realmadrid", "boca", "river"}) {
+            Item jersey = KitRegistrar.JERSEYS[KitRegistrar.indexOf(team)];
+            assertEquals(new ResourceLocation("sports", "textures/crests/" + team + ".png"), ClubCrests.forJersey(new ItemStack(jersey)));
+        }
+    }
+
+    @Test public void refereesAndUnrelatedEquipmentHaveNoClubCrest() {
+        assertNull(ClubCrests.forJersey(new ItemStack(KitRegistrar.JERSEYS[KitRegistrar.indexOf("arbitro")])));
+        assertNull(ClubCrests.forJersey(new ItemStack(new Item())));
+    }
+
+    @Test public void removingTheShirtRemovesTheCrest() {
+        assertNull(ClubCrests.forJersey(ItemStack.EMPTY));
+        assertNull(ClubCrests.forJersey(null));
+    }
+
+    @Test public void everyClubPrintIsPackagedWithTransparentBackground() throws Exception {
+        for (String team : new String[]{"barcelona", "realmadrid", "boca", "river"}) {
+            try (InputStream in = getClass().getResourceAsStream("/assets/sports/textures/crests/" + team + ".png")) {
+                assertNotNull(team, in);
+                BufferedImage image = ImageIO.read(in);
+                assertNotNull(team, image);
+                assertTrue(team, image.getColorModel().hasAlpha());
+                assertEquals(team, 0, image.getRGB(0, 0) >>> 24);
+                assertTrue(team, (image.getRGB(image.getWidth()/2, image.getHeight()/2) >>> 24) > 0);
+            }
+        }
+    }
+}
