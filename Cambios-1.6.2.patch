+package net.sports.kit.client;
+
+import java.nio.FloatBuffer;
+import net.minecraft.client.Minecraft;
+import net.minecraft.client.renderer.GlStateManager;
+import net.minecraft.entity.Entity;
+import net.minecraft.entity.EntityLivingBase;
+import net.minecraft.inventory.EntityEquipmentSlot;
+import net.minecraft.item.ItemStack;
+import net.minecraft.util.ResourceLocation;
+import net.minecraftforge.fml.relauncher.Side;
+import net.minecraftforge.fml.relauncher.SideOnly;
+import net.sports.kit.KitRegistrar;
+import org.lwjgl.BufferUtils;
+import org.lwjgl.opengl.GL11;
+import org.lwjgl.opengl.GL14;
+
+/** A separate chest print, selected from the jersey actually being worn. */
+@SideOnly(Side.CLIENT)
+public final class ClubCrests {
+    private static final ResourceLocation[] TEXTURES = new ResourceLocation[KitRegistrar.TEAMS.length];
+    private static final FloatBuffer COLOR = BufferUtils.createFloatBuffer(16);
+    private static final FloatBuffer NORMAL = BufferUtils.createFloatBuffer(16);
+    private static final float CENTER_X = 2.0F, CENTER_Y = 3.1F, HALF_SIZE = 1.2F;
+
+    static {
+        for (int i = 0; i < KitRegistrar.TEAMS.length; i++) {
+            String team = KitRegistrar.TEAMS[i];
+            if (!"arbitro".equals(team)) {
+                TEXTURES[i] = new ResourceLocation("sports", "textures/crests/" + team + ".png");
+            }
+        }
+    }
+
+    private ClubCrests() {}
+
+    static ResourceLocation forJersey(ItemStack jersey) {
+        if (jersey == null || jersey.isEmpty()) return null;
+        for (int i = 0; i < KitRegistrar.JERSEYS.length; i++) {
+            if (jersey.getItem() == KitRegistrar.JERSEYS[i]) return TEXTURES[i];
+        }
+        return null;
+    }
+
+    public static void render(ModelKit model, Entity entity, float scale) {
+        if (!(entity instanceof EntityLivingBase) || entity.isInvisible()) return;
+        ResourceLocation crest = forJersey(((EntityLivingBase) entity).getItemStackFromSlot(EntityEquipmentSlot.CHEST));
+        if (crest == null) return;
+        int texture = GL11.glGetInteger(GL11.GL_TEXTURE_BINDING_2D);
+        try {
+            Minecraft.getMinecraft().getTextureManager().bindTexture(crest);
+            draw(model, scale);
+        } finally {
+            GlStateManager.bindTexture(texture);
+        }
+    }
+
+    /** Draw the currently bound crest on the fitted torso, preserving render state. */
+    static void draw(ModelKit model, float scale) {
+        boolean cull = GL11.glIsEnabled(GL11.GL_CULL_FACE);
+        boolean blend = GL11.glIsEnabled(GL11.GL_BLEND);
+        boolean textured = GL11.glIsEnabled(GL11.GL_TEXTURE_2D);
+        boolean depthWrite = GL11.glGetBoolean(GL11.GL_DEPTH_WRITEMASK);
+        boolean offset = GL11.glIsEnabled(GL11.GL_POLYGON_OFFSET_FILL);
+        float factor = GL11.glGetFloat(GL11.GL_POLYGON_OFFSET_FACTOR);
+        float units = GL11.glGetFloat(GL11.GL_POLYGON_OFFSET_UNITS);
+        int srcRgb = GL11.glGetInteger(GL14.GL_BLEND_SRC_RGB);
+        int dstRgb = GL11.glGetInteger(GL14.GL_BLEND_DST_RGB);
+        int srcAlpha = GL11.glGetInteger(GL14.GL_BLEND_SRC_ALPHA);
+        int dstAlpha = GL11.glGetInteger(GL14.GL_BLEND_DST_ALPHA);
+        COLOR.clear(); NORMAL.clear();
+        GL11.glGetFloat(GL11.GL_CURRENT_COLOR, COLOR);
+        GL11.glGetFloat(GL11.GL_CURRENT_NORMAL, NORMAL);
+        GlStateManager.pushMatrix();
+        try {
+            // Keep the shirt's lighting and lightmap; this print follows its body joint.
+            model.bipedBody.postRender(scale);
+            GlStateManager.disableCull();
+            GlStateManager.enableTexture2D();
+            GlStateManager.enableBlend();
+            GlStateManager.tryBlendFuncSeparate(GL11.GL_SRC_ALPHA, GL11.GL_ONE_MINUS_SRC_ALPHA, GL11.GL_ONE, GL11.GL_ZERO);
+            GlStateManager.depthMask(false);
+            GlStateManager.enablePolygonOffset();
+            GlStateManager.doPolygonOffset(-1, -1);
+            GlStateManager.color(1, 1, 1, 1);
+            float left = (CENTER_X - HALF_SIZE) * scale;
+            float right = (CENTER_X + HALF_SIZE) * scale;
+            float top = (CENTER_Y - HALF_SIZE) * scale;
+            float bottom = (CENTER_Y + HALF_SIZE) * scale;
+            float front = -model.printDepth() * scale;
+            GL11.glNormal3f(0, 0, -1);
+            GL11.glBegin(GL11.GL_QUADS);
+            GL11.glTexCoord2f(0, 0); GL11.glVertex3f(left, top, front);
+            GL11.glTexCoord2f(0, 1); GL11.glVertex3f(left, bottom, front);
+            GL11.glTexCoord2f(1, 1); GL11.glVertex3f(right, bottom, front);
+            GL11.glTexCoord2f(1, 0); GL11.glVertex3f(right, top, front);
+            GL11.glEnd();
+        } finally {
+            GlStateManager.depthMask(depthWrite);
+            GlStateManager.doPolygonOffset(factor, units);
+            if (!offset) GlStateManager.disablePolygonOffset();
+            GlStateManager.tryBlendFuncSeparate(srcRgb, dstRgb, srcAlpha, dstAlpha);
+            if (!blend) GlStateManager.disableBlend();
+            if (cull) GlStateManager.enableCull();
+            if (!textured) GlStateManager.disableTexture2D();
+            GlStateManager.color(COLOR.get(0), COLOR.get(1), COLOR.get(2), COLOR.get(3));
+            GL11.glNormal3f(NORMAL.get(0), NORMAL.get(1), NORMAL.get(2));
+            GlStateManager.popMatrix();
+        }
+    }
+}
