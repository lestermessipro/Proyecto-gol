+package net.sports.kit.client;
+
+import com.google.gson.GsonBuilder;
+import java.awt.Color;
+import java.awt.Font;
+import java.awt.Graphics2D;
+import java.awt.image.BufferedImage;
+import java.io.File;
+import java.nio.ByteBuffer;
+import java.nio.FloatBuffer;
+import java.nio.file.Files;
+import java.nio.file.Paths;
+import java.util.Arrays;
+import java.util.LinkedHashMap;
+import java.util.Map;
+import javax.imageio.ImageIO;
+import net.minecraft.client.renderer.GlStateManager;
+import net.minecraft.client.renderer.OpenGlHelper;
+import net.minecraft.client.renderer.RenderHelper;
+import org.lwjgl.BufferUtils;
+import org.lwjgl.opengl.Display;
+import org.lwjgl.opengl.DisplayMode;
+import org.lwjgl.opengl.GL11;
+import org.lwjgl.opengl.GL13;
+import org.lwjgl.opengl.GL14;
+
+/** Review of the real shirt mesh and chest print; does not start a game session. */
+public final class CrestReview {
+    private static final int WIDTH = 1280, HEIGHT = 900;
+    private static final float SCALE = .0625F;
+    private static final String[] TEAMS = {"barcelona", "realmadrid", "boca", "river"};
+    private static final String[] NAMES = {"BARÇA", "REAL MADRID", "BOCA", "RIVER"};
+
+    public static void main(String[] args) throws Exception {
+        Display.setDisplayMode(new DisplayMode(WIDTH, HEIGHT)); Display.create();
+        OpenGlHelper.defaultTexUnit = GL13.GL_TEXTURE0;
+        OpenGlHelper.lightmapTexUnit = GL13.GL_TEXTURE1;
+        try {
+            int[] shirts = new int[4], crests = new int[4];
+            for (int i=0;i<4;i++) {
+                shirts[i] = texture("src/main/resources/assets/sports/textures/models/armor/" + TEAMS[i] + "_layer_1.png", false);
+                crests[i] = texture("src/main/resources/assets/sports/textures/crests/" + TEAMS[i] + ".png", true);
+            }
+            int frontChecks = 0, backChecks = 0, stateChecks = 0;
+            for (boolean slim : new boolean[]{false,true}) for (int pose=0;pose<3;pose++) for (int i=0;i<4;i++) {
+                ModelKit model = model(slim, pose);
+                GL11.glViewport(0,0,320,400);
+                for (boolean back : new boolean[]{false,true}) {
+                    byte[] base = image(model, shirts[i], crests[i], back, false);
+                    byte[] print = image(model, shirts[i], crests[i], back, true);
+                    if (back) {
+                        if (!Arrays.equals(base,print)) throw new AssertionError("Crest leaked through the back: " + TEAMS[i]);
+                        backChecks++;
+                    } else {
+                        if (Arrays.equals(base,print)) throw new AssertionError("Missing chest crest: " + TEAMS[i]);
+                        frontChecks++;
+                    }
+                }
+                GlStateManager.color(.7F,.8F,.9F,.6F);GlStateManager.enableCull();GlStateManager.disableBlend();
+                GlStateManager.depthMask(true);GlStateManager.enablePolygonOffset();GlStateManager.doPolygonOffset(2,3);
+                GlStateManager.tryBlendFuncSeparate(GL11.GL_ONE,GL11.GL_ZERO,GL11.GL_ZERO,GL11.GL_ONE);
+                GL11.glNormal3f(.2F,.3F,.4F);
+                float[] before = state();ClubCrests.draw(model,SCALE);float[] after = state();
+                if(!Arrays.equals(before,after)) throw new AssertionError("Leaked OpenGL state");
+                GlStateManager.disablePolygonOffset();GlStateManager.disableCull();stateChecks++;
+            }
+            GL11.glClearColor(.045F,.065F,.085F,1);GL11.glClear(GL11.GL_COLOR_BUFFER_BIT|GL11.GL_DEPTH_BUFFER_BIT);
+            for(int i=0;i<4;i++) for(int row=0;row<2;row++) {
+                GL11.glViewport(i*320,(1-row)*420,320,400);
+                scene(model(false,row),shirts[i],crests[i],false,true);
+            }
+            BufferedImage picture = screenshot();Graphics2D g=picture.createGraphics();
+            g.setColor(new Color(230,240,248));g.setFont(new Font("SansSerif",Font.BOLD,22));
+            for(int i=0;i<4;i++)g.drawString(NAMES[i],i*320+30,36);
+            g.setFont(new Font("SansSerif",Font.BOLD,17));
+            for(int i=0;i<4;i++)g.drawString("TORSO EN MOVIMIENTO",i*320+25,456);
+            g.setFont(new Font("SansSerif",Font.PLAIN,17));g.setColor(new Color(156,177,193));
+            g.drawString("Escudos sobre la camiseta · revisión OpenGL del modelo real · no es una captura de una partida",30,78);g.dispose();
+            ImageIO.write(picture,"png",new File(args[0]));
+            int error=GL11.glGetError();if(error!=0)throw new AssertionError("OpenGL error "+error);
+            Map<String,Object> report=new LinkedHashMap<>();report.put("front_print_checks",frontChecks);report.put("back_occlusion_checks",backChecks);
+            report.put("render_state_checks",stateChecks);report.put("clubs",TEAMS);report.put("poses",3);report.put("skin_models",2);
+            report.put("opengl_error",error);report.put("game_session_tested",false);
+            String json=new GsonBuilder().setPrettyPrinting().create().toJson(report);Files.write(Paths.get(args[1]),json.getBytes("UTF-8"));System.out.println(json);
+        } finally { Display.destroy(); }
+    }
+
+    private static ModelKit model(boolean slim,int pose) {
+        ModelKit model=new ModelKit(.28F,slim);model.isChild=false;
+        if(pose==1){model.bipedBody.rotateAngleY=.35F;model.bipedBody.rotateAngleZ=.13F;model.bipedBody.rotationPointY=1.5F;}
+        if(pose==2){model.bipedBody.rotateAngleX=.35F;model.bipedBody.rotateAngleY=-.3F;model.bipedBody.rotationPointZ=1;}
+        return model;
+    }
+
+    private static void scene(ModelKit model,int shirt,int crest,boolean back,boolean printed) {
+        GlStateManager.matrixMode(GL11.GL_PROJECTION);GlStateManager.loadIdentity();GL11.glOrtho(-.55,.55,-.98,.2,-5,5);
+        GlStateManager.matrixMode(GL11.GL_MODELVIEW);GlStateManager.loadIdentity();GlStateManager.rotate(back?0:180,0,1,0);
+        GlStateManager.scale(-1,-1,1);GlStateManager.enableDepth();GlStateManager.depthMask(true);GlStateManager.disableCull();
+        GlStateManager.enableTexture2D();GlStateManager.enableAlpha();GlStateManager.alphaFunc(GL11.GL_GREATER,.1F);
+        GlStateManager.disableBlend();GlStateManager.color(1,1,1,1);RenderHelper.enableStandardItemLighting();
+        GlStateManager.bindTexture(shirt);model.bipedBody.render(SCALE);model.bipedRightArm.render(SCALE);model.bipedLeftArm.render(SCALE);
+        if(printed){GlStateManager.bindTexture(crest);ClubCrests.draw(model,SCALE);}
+    }
+
+    private static byte[] image(ModelKit model,int shirt,int crest,boolean back,boolean printed) {
+        GL11.glClearColor(.045F,.065F,.085F,1);GL11.glClear(GL11.GL_COLOR_BUFFER_BIT|GL11.GL_DEPTH_BUFFER_BIT);
+        scene(model,shirt,crest,back,printed);ByteBuffer b=BufferUtils.createByteBuffer(320*400*4);
+        GL11.glReadPixels(0,0,320,400,GL11.GL_RGBA,GL11.GL_UNSIGNED_BYTE,b);byte[] bytes=new byte[b.capacity()];b.get(bytes);return bytes;
+    }
+
+    private static float[] state() {
+        FloatBuffer b=BufferUtils.createFloatBuffer(16);float[] result=new float[33];int n=0;
+        for(int flag:new int[]{GL11.GL_CULL_FACE,GL11.GL_BLEND,GL11.GL_TEXTURE_2D,GL11.GL_LIGHTING,GL11.GL_POLYGON_OFFSET_FILL})result[n++]=GL11.glIsEnabled(flag)?1:0;
+        result[n++]=GL11.glGetBoolean(GL11.GL_DEPTH_WRITEMASK)?1:0;
+        for(int flag:new int[]{GL14.GL_BLEND_SRC_RGB,GL14.GL_BLEND_DST_RGB,GL14.GL_BLEND_SRC_ALPHA,GL14.GL_BLEND_DST_ALPHA,GL11.GL_TEXTURE_BINDING_2D,GL11.GL_MODELVIEW_STACK_DEPTH})result[n++]=GL11.glGetInteger(flag);
+        for(int flag:new int[]{GL11.GL_POLYGON_OFFSET_FACTOR,GL11.GL_POLYGON_OFFSET_UNITS})result[n++]=GL11.glGetFloat(flag);
+        for(int flag:new int[]{GL11.GL_CURRENT_COLOR,GL11.GL_CURRENT_NORMAL}){b.clear();GL11.glGetFloat(flag,b);for(int i=0;i<(flag==GL11.GL_CURRENT_COLOR?4:3);i++)result[n++]=b.get(i);}
+        return result;
+    }
+
+    private static int texture(String path,boolean smooth) throws Exception {
+        BufferedImage im=ImageIO.read(new File(path));ByteBuffer b=BufferUtils.createByteBuffer(im.getWidth()*im.getHeight()*4);
+        for(int y=0;y<im.getHeight();y++)for(int x=0;x<im.getWidth();x++){int p=im.getRGB(x,y);b.put((byte)(p>>16)).put((byte)(p>>8)).put((byte)p).put((byte)(p>>24));}
+        b.flip();int id=GL11.glGenTextures();GlStateManager.bindTexture(id);
+        GL11.glTexParameteri(GL11.GL_TEXTURE_2D,GL11.GL_TEXTURE_MIN_FILTER,smooth?GL11.GL_LINEAR:GL11.GL_NEAREST);
+        GL11.glTexParameteri(GL11.GL_TEXTURE_2D,GL11.GL_TEXTURE_MAG_FILTER,smooth?GL11.GL_LINEAR:GL11.GL_NEAREST);
+        GL11.glTexImage2D(GL11.GL_TEXTURE_2D,0,GL11.GL_RGBA,im.getWidth(),im.getHeight(),0,GL11.GL_RGBA,GL11.GL_UNSIGNED_BYTE,b);return id;
+    }
+
+    private static BufferedImage screenshot() {
+        ByteBuffer b=BufferUtils.createByteBuffer(WIDTH*HEIGHT*4);GL11.glReadPixels(0,0,WIDTH,HEIGHT,GL11.GL_RGBA,GL11.GL_UNSIGNED_BYTE,b);
+        BufferedImage im=new BufferedImage(WIDTH,HEIGHT,BufferedImage.TYPE_INT_RGB);
+        for(int y=0;y<HEIGHT;y++)for(int x=0;x<WIDTH;x++){int i=((HEIGHT-1-y)*WIDTH+x)*4;im.setRGB(x,y,((b.get(i)&255)<<16)|((b.get(i+1)&255)<<8)|(b.get(i+2)&255));}return im;
+    }
+}
