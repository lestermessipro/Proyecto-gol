+            ByteBuf b=((FMLProxyPacket)out.get(0)).payload();
+            try {assertEquals(6,b.readableBytes());assertEquals(5,b.readUnsignedByte());assertEquals(317,b.readInt());assertTrue(b.readBoolean());}
