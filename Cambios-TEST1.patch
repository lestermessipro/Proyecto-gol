+package net.sports.client;
+
+import org.junit.Test;
+import static org.junit.Assert.*;
+
+public class HudTimingTest {
+    @Test public void oneSecondOfRunningHasTheSameCostRegardlessOfFrameChunking() {
+        for(int[] chunks:new int[][]{{1},{2},{5},{6,7,7},{10}}) {
+            int energy=6000,total=0,index=0;
+            while(total<100){int steps=Math.min(100-total,chunks[index++%chunks.length]);energy=HudTiming.endurance(energy,true,steps);total+=steps;}
+            assertEquals(5700,energy);
+        }
+    }
+    @Test public void recoveryUsesElapsedTimeAndStopsAtTheMaximum() {
+        assertEquals(1100,HudTiming.endurance(1000,false,100));
+        assertEquals(6000,HudTiming.endurance(5990,false,100));
+        assertEquals(6000,HudTiming.endurance(0,false,Integer.MAX_VALUE));
+    }
+    @Test public void batchedDrainMatchesTheExistingSingleStepRuleExactly() {
+        for(int initial=0;initial<=6000;initial+=17)for(int steps:new int[]{0,1,2,3,10,100,1000,10000}) {
+            int reference=initial;for(int i=0;i<steps;i++)if(reference>3)reference-=3;
+            assertEquals(reference,HudTiming.endurance(initial,true,steps));
+        }
+    }
+    @Test public void pausedOrInvalidElapsedTimeDoesNotDrainStamina() {
+        assertEquals(1000,HudTiming.endurance(1000,true,0));assertEquals(1000,HudTiming.endurance(1000,true,-10));
+        assertEquals(3,HudTiming.endurance(3,true,100));assertEquals(0,HudTiming.endurance(0,true,100));
+    }
+}
