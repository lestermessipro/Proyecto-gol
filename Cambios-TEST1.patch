+package net.sports.client;
+
+/** Time-based HUD bookkeeping using the existing 100 Hz input timer. */
+public final class HudTiming {
+    private HudTiming() {}
+    public static int endurance(int current,boolean running,int elapsedTicks) {
+        int energy=Math.max(0,Math.min(6000,current));
+        int steps=Math.max(0,elapsedTicks);
+        if(running) {
+            int drainSteps=Math.min(steps,Math.max(0,(energy-1)/3));
+            return energy-3*drainSteps;
+        }
+        return energy+Math.min(steps,6000-energy);
+    }
+}
