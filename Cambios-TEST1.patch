+        Probe codec=new Probe();codec.registerPacket(CapturingPacket.class);codec.postInitialise();
+        EmbeddedChannel channel=channel();CapturingPacket.decoded=0;
+        ByteBuf b=Unpooled.buffer().writeByte(0).writeInt(12345);
+        try {
+            // There is no Minecraft client singleton or server player in this test.
+            // Correct SERVER routing decodes and safely skips the absent handler.
+            codec.read(channel.pipeline().firstContext(),new FMLProxyPacket(new PacketBuffer(b),"GCA"));
+            assertEquals(12345,CapturingPacket.decoded);
+        } finally {b.release();channel.finishAndReleaseAll();}
