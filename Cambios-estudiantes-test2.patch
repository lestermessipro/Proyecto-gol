+package net.sports.client.gui;
+
+import net.minecraft.client.Minecraft;
+import net.minecraft.client.gui.Gui;
+import net.minecraft.client.renderer.GlStateManager;
+import net.minecraft.util.ResourceLocation;
+import org.lwjgl.opengl.GL11;
+import org.lwjgl.opengl.GL14;
+
+public final class ScoreboardCrests {
+    private ScoreboardCrests() {}
+
+    public static void render(ResourceLocation a, ResourceLocation b, ScoreboardLayout layout) {
+        if (a == null && b == null) return;
+        int texture = GL11.glGetInteger(GL11.GL_TEXTURE_BINDING_2D);
+        boolean blend = GL11.glIsEnabled(GL11.GL_BLEND);
+        int src = GL11.glGetInteger(GL14.GL_BLEND_SRC_RGB), dst = GL11.glGetInteger(GL14.GL_BLEND_DST_RGB);
+        int srcA = GL11.glGetInteger(GL14.GL_BLEND_SRC_ALPHA), dstA = GL11.glGetInteger(GL14.GL_BLEND_DST_ALPHA);
+        try {
+            GlStateManager.color(1, 1, 1, 1);
+            GlStateManager.enableBlend();
+            GlStateManager.tryBlendFuncSeparate(GL11.GL_SRC_ALPHA, GL11.GL_ONE_MINUS_SRC_ALPHA, GL11.GL_ONE, GL11.GL_ZERO);
+            draw(a, layout.iconAX); draw(b, layout.iconBX);
+        } finally {
+            GlStateManager.bindTexture(texture);
+            GlStateManager.tryBlendFuncSeparate(src, dst, srcA, dstA);
+            if (!blend) GlStateManager.disableBlend();
+        }
+    }
+
+    private static void draw(ResourceLocation crest, int x) {
+        if (crest == null) return;
+        Minecraft.getMinecraft().getTextureManager().bindTexture(crest);
+        GL11.glTexParameteri(GL11.GL_TEXTURE_2D, GL11.GL_TEXTURE_MIN_FILTER, GL11.GL_LINEAR);
+        GL11.glTexParameteri(GL11.GL_TEXTURE_2D, GL11.GL_TEXTURE_MAG_FILTER, GL11.GL_LINEAR);
+        drawBound(x);
+    }
+
+    static void drawBound(int x) {
+        Gui.drawModalRectWithCustomSizedTexture(x, ScoreboardLayout.TOP + 3, 0, 0,
+            ScoreboardLayout.ICON, ScoreboardLayout.ICON, ScoreboardLayout.ICON, ScoreboardLayout.ICON);
+    }
+}
