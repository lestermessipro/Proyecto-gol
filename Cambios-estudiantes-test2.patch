+package net.sports.client.gui;
+
+/** Logical HUD coordinates before the existing compact scoreboard scaling. */
+public final class ScoreboardLayout {
+    public static final int LEFT = 10, TOP = 8, HEIGHT = 24, ICON = 18;
+    public final int nameWidthA, nameWidthB;
+    public final boolean crestA, crestB;
+    public final int iconAX, iconBX, nameAX, nameBX, scoreAX, scoreBX, width;
+
+    public ScoreboardLayout(int widthA, int widthB, boolean crestA, boolean crestB) {
+        this.nameWidthA = Math.max(0, widthA); this.nameWidthB = Math.max(0, widthB);
+        this.crestA = crestA; this.crestB = crestB;
+        this.iconAX = LEFT + 118;
+        this.nameAX = iconAX + (crestA ? ICON + 4 : 0);
+        this.scoreAX = nameAX + nameWidthA + 10;
+        this.scoreBX = scoreAX + 28 + 16;
+        this.iconBX = scoreBX + 28 + 8;
+        this.nameBX = iconBX + (crestB ? ICON + 4 : 0);
+        this.width = nameBX + nameWidthB + 12 - LEFT;
+    }
+
+    public float scaleFor(int scaledScreenWidth) {
+        return Math.min(.65F, Math.max(1, scaledScreenWidth - 12F) / (LEFT + width));
+    }
+}
