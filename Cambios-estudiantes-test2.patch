+
+public class ScoreboardLayoutTest {
+    @Test public void crestSlotsNeverOverlapNamesOrScores() {
+        for(boolean a:new boolean[]{false,true})for(boolean b:new boolean[]{false,true}) {
+            ScoreboardLayout l=new ScoreboardLayout(70,70,a,b);
+            assertTrue(l.nameAX>=l.iconAX+(a?18:0));assertTrue(l.scoreAX>l.nameAX+70);
