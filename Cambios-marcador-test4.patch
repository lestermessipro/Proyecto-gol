+package net.sports.client.gui;
+
+import org.junit.Test;
+import static org.junit.Assert.*;
+
+public class ScoreboardStyleTest {
+    @Test public void referenceMatchUsesBocaBandAndRiverDiagonal() {
+        ScoreboardStyle a=ScoreboardStyle.of("boca","Boca Juniors",0,0),b=ScoreboardStyle.of("river","River Plate",0,0);
+        assertEquals("BOC",a.abbreviation);assertEquals(ScoreboardStyle.Pattern.HORIZONTAL,a.pattern);
+        assertEquals("RIV",b.abbreviation);assertEquals(ScoreboardStyle.Pattern.DIAGONAL,b.pattern);
+        assertEquals(0xFFFFFF,a.text);assertEquals(0x111111,b.text);
+    }
+    @Test public void allOtherClubsHaveTheirOwnAbbreviationAndKitPattern() {
+        assertEquals("BAR",ScoreboardStyle.of("barcelona","",0,0).abbreviation);
+        assertEquals("RMA",ScoreboardStyle.of("realmadrid","",0,0).abbreviation);
+        assertEquals("EST",ScoreboardStyle.of("estudiantes","",0,0).abbreviation);
+        assertEquals(ScoreboardStyle.Pattern.VERTICAL,ScoreboardStyle.of("estudiantes","",0,0).pattern);
+        assertEquals(ScoreboardStyle.Pattern.GOLD_TRIM,ScoreboardStyle.of("realmadrid","",0,0).pattern);
+    }
+    @Test public void selectedClubStyleSurvivesAChangedDisplayName() {
+        ScoreboardStyle style=ScoreboardStyle.of("river","Mi equipo",123,456);
+        assertEquals("RIV",style.abbreviation);assertTrue(style.matches("river","Mi equipo",123,456));
+        assertFalse(style.matches("boca","Mi equipo",123,456));assertFalse(style.matches("river","Mi equipo",123,789));
+        assertEquals("BOC",ScoreboardStyle.of("","Boca Juniors",0,0).abbreviation);
+    }
+    @Test public void customTeamsUseTheirColorsAndSafeShortNames() {
+        ScoreboardStyle style=ScoreboardStyle.of("custom","§cÁguilas",0xFFFF3300,0xFF112244);
+        assertEquals("AGU",style.abbreviation);assertEquals(0x112244,style.base);assertEquals(0xFF3300,style.accent);
+        assertEquals(ScoreboardStyle.Pattern.PLAIN,style.pattern);assertEquals("---",ScoreboardStyle.of(null,null,0,0).abbreviation);
+    }
+}
