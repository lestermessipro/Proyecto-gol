+package net.sports.client.gui;
+
+import java.text.Normalizer;
+import java.util.Locale;
+import net.sports.match.TeamInfo;
+import net.sports.match.TeamRegistry;
+
+/** Club shirt colors, independent of crest images. */
+public final class ScoreboardStyle {
+    public enum Pattern { PLAIN, HORIZONTAL, DIAGONAL, VERTICAL, GOLD_TRIM }
+    public final String abbreviation;
+    public final int base, accent, text, outline;
+    public final Pattern pattern;
+    private final String kit, name;
+    private final int primary, secondary;
+
+    private ScoreboardStyle(String kit,String name,int primary,int secondary,String abbreviation,int base,int accent,int text,Pattern pattern) {
+        this.kit=kit;this.name=name;this.primary=primary;this.secondary=secondary;
+        this.abbreviation=abbreviation;this.base=base;this.accent=accent;this.text=text;
+        this.outline=text==0xFFFFFF?0x141414:0xFFFFFF;this.pattern=pattern;
+    }
+
+    public boolean matches(String kit,String name,int primary,int secondary) {
+        return this.kit.equals(safe(kit))&&this.name.equals(safe(name))&&this.primary==primary&&this.secondary==secondary;
+    }
+
+    public static ScoreboardStyle of(String kit,String name,int primary,int secondary) {
+        kit=safe(kit);name=safe(name);
+        TeamInfo team=TeamRegistry.find(kit.isEmpty()?name:kit);
+        String id=team==null?"":team.kit;
+        String code;int base,accent,text;Pattern pattern;
+        switch(id) {
+            case "boca":code="BOC";base=0x123D8E;accent=0xFFD339;text=0xFFFFFF;pattern=Pattern.HORIZONTAL;break;
+            case "river":code="RIV";base=0xF7F5F1;accent=0xD51935;text=0x111111;pattern=Pattern.DIAGONAL;break;
+            case "barcelona":code="BAR";base=0x124E93;accent=0xA31442;text=0xFFFFFF;pattern=Pattern.VERTICAL;break;
+            case "realmadrid":code="RMA";base=0xF7F5F1;accent=0xD9B756;text=0x111111;pattern=Pattern.GOLD_TRIM;break;
+            case "estudiantes":code="EST";base=0xF7F5F1;accent=0xCA2036;text=0x111111;pattern=Pattern.VERTICAL;break;
+            default:
+                code=shortName(name);base=secondary&0xFFFFFF;accent=primary&0xFFFFFF;
+                int brightness=((base>>16)&255)*299+((base>>8)&255)*587+(base&255)*114;
+                text=brightness>145000?0x111111:0xFFFFFF;pattern=Pattern.PLAIN;
+        }
+        return new ScoreboardStyle(kit,name,primary,secondary,code,base,accent,text,pattern);
+    }
+
+    private static String shortName(String name) {
+        String clean=Normalizer.normalize(name.replaceAll("§.",""),Normalizer.Form.NFD)
+            .replaceAll("\\p{M}+","").toUpperCase(Locale.ROOT).replaceAll("[^A-Z0-9]","");
+        return clean.isEmpty()?"---":clean.substring(0,Math.min(3,clean.length()));
+    }
+    private static String safe(String value){return value==null?"":value;}
+}
