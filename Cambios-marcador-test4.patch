+            case GOLD_TRIM:
+                Gui.drawRect(x,y+h-4,x+w,y+h-1,0xFF000000|style.accent);
+                Gui.drawRect(x,y+h-1,x+w,y+h,0xFF49377D);break;
+            default:Gui.drawRect(x,y+h-2,x+w,y+h,0xFF000000|style.accent);
+        }
+    }
