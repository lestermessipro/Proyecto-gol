+import java.awt.AlphaComposite;
+import java.awt.Graphics2D;
+import java.awt.RenderingHints;
+import java.awt.image.BufferedImage;
+import java.io.File;
+import javax.imageio.ImageIO;
+
+/** Pixel-grid export: nearest-neighbor size conversion and optional binary alpha. */
+public final class ExportInventorySprite {
+    public static void main(String[] args) throws Exception {
+        BufferedImage input=ImageIO.read(new File(args[0]));int size=Integer.parseInt(args[2]);
+        BufferedImage output=new BufferedImage(size,size,BufferedImage.TYPE_INT_ARGB);
+        Graphics2D graphics=output.createGraphics();graphics.setComposite(AlphaComposite.Src);
+        graphics.setRenderingHint(RenderingHints.KEY_INTERPOLATION,RenderingHints.VALUE_INTERPOLATION_NEAREST_NEIGHBOR);
+        graphics.drawImage(input,0,0,size,size,null);graphics.dispose();
+        if(args.length>3&&args[3].equals("--binary-alpha")) {
+            for(int y=0;y<size;y++)for(int x=0;x<size;x++) {
+                int pixel=output.getRGB(x,y);output.setRGB(x,y,(pixel>>>24)<128?0:pixel|0xFF000000);
+            }
+        }
+        ImageIO.write(output,"png",new File(args[1]));
+    }
+}
