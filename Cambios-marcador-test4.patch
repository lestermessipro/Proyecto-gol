+        } finally {GlStateManager.popMatrix();GlStateManager.color(1,1,1,1);}
+    }
+
+    static void panel(ScoreboardStyle style,int x,int y) {
+        int w=ScoreboardLayout.TEAM_WIDTH,h=ScoreboardLayout.HEIGHT;
+        Gui.drawRect(x,y,x+w,y+h,0xFF000000|style.base);
+        switch(style.pattern) {
+            case HORIZONTAL:Gui.drawRect(x,y+9,x+w,y+18,0xFF000000|style.accent);break;
+            case VERTICAL:
+                for(int i=0;i<6;i++)if(i%2==1)Gui.drawRect(x+i*w/6,y,x+(i+1)*w/6,y+h,0xFF000000|style.accent);
