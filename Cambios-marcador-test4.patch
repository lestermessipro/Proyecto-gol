+    public static void draw(ScoreboardLayout layout,ScoreboardStyle a,ScoreboardStyle b,String score,
+                            String period,String clock,String total,boolean paused,Font font) {
+        int x=ScoreboardLayout.LEFT,y=ScoreboardLayout.TOP,h=ScoreboardLayout.HEIGHT;
+        Gui.drawRect(x-1,y-1,x+layout.width+1,y+h+1,0xE0141414);
+        panel(a,x,y);panel(b,layout.awayX,y);
+        Gui.drawRect(layout.centerX,y,layout.awayX,y+h,0xFFF6F4EF);
+        Gui.drawRect(layout.centerX,y,layout.centerX+1,y+h,0xFFDDDAD2);
+        Gui.drawRect(layout.awayX-1,y,layout.awayX,y+h,0xFFDDDAD2);
+        label(font,a.abbreviation,x,ScoreboardLayout.TEAM_WIDTH,y,a.text,a.outline,ScoreboardLayout.LABEL_SCALE,true);
+        label(font,b.abbreviation,layout.awayX,ScoreboardLayout.TEAM_WIDTH,y,b.text,b.outline,ScoreboardLayout.LABEL_SCALE,true);
+        label(font,score,layout.centerX,layout.centerWidth,y,0x111111,0,ScoreboardLayout.SCORE_SCALE,false);
+        String status=(period==null?"":period)+"  "+(clock==null?"":clock)+(total==null||total.isEmpty()?"":" / "+total);
+        Gui.drawRect(x,y+h+3,x+layout.width,y+h+14,0xC0141418);
+        float small=Math.min(.8F,(layout.width-8F)/Math.max(1,font.width(status)));
