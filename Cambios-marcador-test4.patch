+    private static void label(Font font,String value,int x,int width,int y,int color,int outline,float scale,boolean border) {
+        GlStateManager.pushMatrix();
+        try {
+            GlStateManager.translate(x+(width-font.width(value)*scale)/2F,y+(ScoreboardLayout.HEIGHT-8*scale)/2F,0);
+            GlStateManager.scale(scale,scale,1);
+            if(border) {
+                GlStateManager.pushMatrix();GlStateManager.translate(-.5F,0,0);font.draw(value,0,0,outline);GlStateManager.popMatrix();
+                GlStateManager.pushMatrix();GlStateManager.translate(.5F,0,0);font.draw(value,0,0,outline);GlStateManager.popMatrix();
+                GlStateManager.pushMatrix();GlStateManager.translate(0,-.5F,0);font.draw(value,0,0,outline);GlStateManager.popMatrix();
+                GlStateManager.pushMatrix();GlStateManager.translate(0,.5F,0);font.draw(value,0,0,outline);GlStateManager.popMatrix();
+            }
+            font.draw(value,0,0,color);
+        } finally {GlStateManager.popMatrix();GlStateManager.color(1,1,1,1);}
+    }
