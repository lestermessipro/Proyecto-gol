+package net.sports.entity;
+
+/** Experimental ground touch. One request produces one free-ball impulse. */
+public final class ManualTouch {
+    public static final float MAX_CHARGE = 18;
+    private ManualTouch() {}
+
+    public static boolean isControl(float charge) {
+        return Float.isFinite(charge) && charge > 0 && charge <= MAX_CHARGE;
+    }
+
+    public static Motion calculate(float charge, float yaw, double playerX, double playerZ,
+                                   double toPlayerX, double toPlayerZ, double ballX, double ballY, double ballZ,
+                                   boolean ballGrounded) {
+        if (!isControl(charge) || !Float.isFinite(yaw)) throw new IllegalArgumentException("Invalid manual touch");
+        double angle = Math.toRadians(yaw), aimX = -Math.sin(angle), aimZ = Math.cos(angle);
+        double forward = Math.max(0, Math.min(.36, playerX * aimX + playerZ * aimZ));
+        double amount = charge / MAX_CHARGE;
+        // The boost fades to zero at the boundary with the original charged pass.
+        double speed = charge / 40.0 + .6 * forward * (1 - amount * amount);
+        double dx = ballX - playerX, dz = ballZ - playerZ;
+        double distance = Math.hypot(toPlayerX, toPlayerZ);
+        double closing = distance < .15 ? Math.hypot(dx, dz) : (dx * toPlayerX + dz * toPlayerZ) / distance;
+        boolean receiving = closing > .22;
+        if (receiving) speed *= .65 + .35 * amount;
+        double vertical = ballGrounded ? 0 : Math.max(-.08, Math.min(.04, ballY * .18));
+        return new Motion(aimX * speed, vertical, aimZ * speed, receiving);
+    }
+
+    public static final class Motion {
+        public final double x, y, z;
+        public final boolean receiving;
+        private Motion(double x, double y, double z, boolean receiving) {
+            this.x = x; this.y = y; this.z = z; this.receiving = receiving;
+        }
+    }
+
+    /** Server player motion fields do not reliably contain walking speed. */
+    public static final class Movement {
+        private boolean initialized;
+        private double lastX, lastZ;
+        private long lastTick;
+        private int dimension;
+        public double x, z;
+
+        public void sample(double positionX, double positionZ, long tick, int dim) {
+            if (initialized && dim == dimension && tick == lastTick) return;
+            long dt = tick - lastTick;
+            double dx = positionX - lastX, dz = positionZ - lastZ;
+            if (!initialized || dim != dimension || dt <= 0 || dt > 2 || Math.hypot(dx, dz) > 1.25 * dt) {
+                x = z = 0;
+            } else {
+                x = .5 * x + .5 * dx / dt;
+                z = .5 * z + .5 * dz / dt;
+                double speed = Math.hypot(x, z);
+                if (speed > .36) { x *= .36 / speed; z *= .36 / speed; }
+            }
+            lastX = positionX; lastZ = positionZ; lastTick = tick; dimension = dim; initialized = true;
+        }
+    }
+}
