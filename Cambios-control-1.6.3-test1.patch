+package net.sports.client.animation;
+
+import net.sports.Anim;
+import org.junit.Test;
+import static org.junit.Assert.*;
+
+public class ManualControlAnimationTest {
+    @Test public void confirmedContactsStartAtContactAndResolveForBothPlayersAndFeet() {
+        assertEquals(FootballActions.Kind.CONTROL_TOUCH,FootballActions.resolve(Anim.CONTROL_TOUCH,false));
+        assertEquals(FootballActions.Kind.CONTROL_RECEIVE,FootballActions.resolve(Anim.CONTROL_RECEIVE,true));
+        for(FootballActions.Kind kind:new FootballActions.Kind[]{FootballActions.Kind.CONTROL_TOUCH,FootballActions.Kind.CONTROL_RECEIVE}) {
+            assertEquals(0,kind.contact);FootballActions.Pose p=new FootballActions.Pose();FootballActions.sample(kind,0,false,p);
+            assertTrue(p.joints.hipRight<-.15);assertTrue(p.joints.legYawRight>.3);
+            FootballActions.sample(kind,kind.duration,false,p);assertEquals(0,p.joints.hipRight,0);
+        }
+    }
+    @Test public void controlRecoveryKeepsTheUninvolvedLegSteppingAndResumesTheFullStride() {
+        FootballActions.Pose action=new FootballActions.Pose();FootballGait.Pose gait=new FootballGait.Pose(),out=new FootballGait.Pose();
+        for(FootballActions.Kind kind:new FootballActions.Kind[]{FootballActions.Kind.CONTROL_TOUCH,FootballActions.Kind.CONTROL_RECEIVE})for(boolean left:new boolean[]{false,true}) {
+            for(int phase=0;phase<32;phase++) {
+                FootballGait.sample(phase*.2F,1,true,gait);FootballActions.sample(kind,0,left,action);
+                RunningStrike.compose(kind,0,left,1,gait,action.joints,out);
+                assertEquals(left?gait.hipRight:gait.hipLeft,left?out.hipRight:out.hipLeft,1e-6);
+                FootballActions.sample(kind,11,left,action);RunningStrike.compose(kind,11,left,1,gait,action.joints,out);
+                assertEquals(gait.hipRight,out.hipRight,1e-6);assertEquals(gait.hipLeft,out.hipLeft,1e-6);
+            }
+        }
+    }
+    @Test public void originalNetworkAnimationIdsStayInPlace() {
+        assertEquals(5,Anim.PASSE.ordinal());assertEquals(26,Anim.EMOTE_RODILLAS.ordinal());
+        assertEquals(27,Anim.CONTROL_TOUCH.ordinal());assertEquals(28,Anim.CONTROL_RECEIVE.ordinal());
+    }
+}
