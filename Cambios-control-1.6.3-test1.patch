+package net.sports.entity;
+
+import com.google.gson.GsonBuilder;
+import java.nio.file.Files;
+import java.nio.file.Paths;
+import java.util.ArrayList;
+import java.util.LinkedHashMap;
+import java.util.List;
+import java.util.Map;
+import net.minecraft.init.Bootstrap;
+
+/** Repeatable real-ball physics comparison on the test grass pitch. No game or network session. */
+public final class ManualTouchReview {
+    public static void main(String[] args) throws Exception {
+        Bootstrap.register();verifyClock();List<Map<String,Object>> scenarios=new ArrayList<>();
+        scenarios.add(compare("toque_en_parado",6,0,0));
+        scenarios.add(compare("conduccion_carrera",12,.2,.2));
+        scenarios.add(compare("conduccion_sprint",12,.3,.3));
+        scenarios.add(compare("recepcion_frontal",6,0,-1.2));
+        Map<String,Object> report=new LinkedHashMap<>();report.put("version","1.6.3-test1");
+        report.put("method","EntitySoccer server physics, grass floor, one manual request, original heading without random spread for comparison");
+        report.put("game_or_network_session_tested",false);report.put("scenarios",scenarios);
+        report.put("control_animations_reset_without_model_render",true);
+        String json=new GsonBuilder().setPrettyPrinting().create().toJson(report);Files.write(Paths.get(args[0]),json.getBytes("UTF-8"));System.out.println(json);
+    }
+    private static void verifyClock() throws Exception {
+        java.lang.reflect.Method finish=net.sports.client.AnimClock.class.getDeclaredMethod("finish",net.sports.client.entity.PlayerParameter.class);
+        finish.setAccessible(true);
+        for(net.sports.Anim action:new net.sports.Anim[]{net.sports.Anim.CONTROL_TOUCH,net.sports.Anim.CONTROL_RECEIVE}) {
+            net.sports.client.entity.PlayerParameter parameter=new net.sports.client.entity.PlayerParameter();
+            parameter.anim=action;parameter.animTime=net.sports.client.animation.FootballActions.resolve(action,false).duration-1;finish.invoke(null,parameter);
+            if(parameter.anim!=action)throw new AssertionError("Premature animation reset");
+            parameter.animTime++;finish.invoke(null,parameter);
+            if(parameter.anim!=net.sports.Anim.RESET)throw new AssertionError("Stale animation without model render");
+        }
+    }
+    private static Map<String,Object> compare(String name,float charge,double playerSpeed,double incoming) {
+        EntitySoccer before=ManualTouchPhysicsTest.ball(),after=ManualTouchPhysicsTest.ball();
+        before.setHeading(0,0,1,charge/40,0);
+        ManualTouch.Motion motion=ManualTouch.calculate(charge,0,0,playerSpeed,0,-.5,0,0,incoming,true);
+        after.applyManualTouch(motion);
+        Map<String,Object> row=new LinkedHashMap<>();row.put("scenario",name);row.put("charge",charge);row.put("player_blocks_per_tick",playerSpeed);
+        row.put("incoming_blocks_per_tick",incoming);row.put("reception",motion.receiving);row.put("old_initial_speed",charge/40.0);row.put("test_initial_speed",Math.hypot(motion.x,motion.z));
+        double oldHeight=0,newHeight=0;
+        for(int tick=1;tick<=120;tick++) {
+            before.onUpdateServer();after.onUpdateServer();oldHeight=Math.max(oldHeight,before.posY);newHeight=Math.max(newHeight,after.posY);
+            if(tick==10){row.put("old_distance_10_ticks",before.posZ);row.put("test_distance_10_ticks",after.posZ);}
+        }
+        row.put("old_max_height",oldHeight);row.put("test_max_height",newHeight);row.put("test_speed_120_ticks",Math.hypot(after.motionX,after.motionZ));
+        return row;
+    }
+}
