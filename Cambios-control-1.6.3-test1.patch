+package net.sports.entity;
+
+import org.junit.Test;
+import static org.junit.Assert.*;
+
+public class ManualTouchTest {
+    private ManualTouch.Motion touch(float power,double movement,double incoming) {
+        return ManualTouch.calculate(power,0,0,movement,0,-.5,0,incoming<0?-.4:0,incoming,true);
+    }
+    @Test public void groundControlHasNoRandomSpreadOrAddedHop() {
+        for(int yaw=-180;yaw<=180;yaw+=15) {
+            ManualTouch.Motion a=ManualTouch.calculate(12,yaw,0,0,0,-.5,0,0,0,true);
+            assertEquals(-Math.sin(Math.toRadians(yaw))*.3,a.x,1e-10);
+            assertEquals(Math.cos(Math.toRadians(yaw))*.3,a.z,1e-10);
+            assertEquals(0,a.y,0);assertFalse(a.receiving);
+        }
+    }
+    @Test public void incomingBallIsCushionedButAnOutgoingBallIsNotAReception() {
+        ManualTouch.Motion receiving=touch(6,0,-1.2),dribble=touch(6,0,.2);
+        assertTrue(receiving.receiving);assertFalse(dribble.receiving);
+        assertTrue(receiving.z>0&&receiving.z<dribble.z);
+        assertTrue(receiving.z<.2);assertEquals(0,receiving.y,0);
+    }
+    @Test public void movementGivesALongerTouchWithoutChangingAim() {
+        double standing=touch(12,0,0).z,walking=touch(12,.2,.2).z,sprinting=touch(12,.3,.3).z;
+        assertTrue(standing<walking);assertTrue(walking<sprinting);assertTrue(sprinting<.45);
+        assertEquals(standing,touch(12,-.2,0).z,1e-10);
+        ManualTouch.Motion sideways=ManualTouch.calculate(12,0,.3,0,0,-.5,0,0,0,true);
+        assertEquals(0,sideways.x,0);assertEquals(standing,sideways.z,1e-10);
+    }
+    @Test public void increasingChargeIsContinuousAndMeetsTheOriginalPassAtTheBoundary() {
+        for(double movement:new double[]{0,.2,.3,.36}) {
+            double previous=0;
+            for(int i=1;i<=180;i++) {
+                double speed=touch(i/10F,movement,movement).z;
+                assertTrue(speed>=previous-1e-7);assertTrue(speed<=.450001);previous=speed;
+            }
+            assertEquals(18/40.0,previous,1e-9);
+        }
+        assertFalse(ManualTouch.isControl(18.01F));assertFalse(ManualTouch.isControl(30));
+    }
+    @Test public void descendingReceptionReducesTheBounceWithoutLiftingAGroundedBall() {
+        ManualTouch.Motion falling=ManualTouch.calculate(6,0,0,0,0,-.5,0,-1.5,-1,false);
+        ManualTouch.Motion rising=ManualTouch.calculate(6,0,0,0,0,-.5,0,1.5,-1,false);
+        assertEquals(-.08,falling.y,0);assertEquals(.04,rising.y,0);
+    }
+    @Test public void invalidAndChargedInputsCannotEnterTheShortControlPath() {
+        for(float value:new float[]{0,-1,19,Float.NaN,Float.POSITIVE_INFINITY}) {
+            assertFalse(ManualTouch.isControl(value));
+            try{touch(value,0,0);fail("must reject invalid control");}catch(IllegalArgumentException expected){}
+        }
+    }
+    @Test public void movementSamplerTracksServerPositionsAndIgnoresDuplicateTicks() {
+        ManualTouch.Movement m=new ManualTouch.Movement();
+        for(int i=0;i<=20;i++)m.sample(0,i*.3,i,0);
+        assertEquals(.3,m.z,.000001);assertEquals(0,m.x,0);
+        double speed=m.z;m.sample(0,100,20,0);assertEquals(speed,m.z,0);
+        m.sample(0,6.3,21,0);assertEquals(.3,m.z,.000001);
+    }
+    @Test public void teleportDimensionChangeAndLongGapsDoNotCreateAPowerBoost() {
+        ManualTouch.Movement m=new ManualTouch.Movement();m.sample(0,0,0,0);m.sample(0,.3,1,0);
+        m.sample(0,100,2,0);assertEquals(0,m.z,0);
+        m.sample(0,100.3,3,1);assertEquals(0,m.z,0);
+        m.sample(0,100.6,20,1);assertEquals(0,m.z,0);
+        for(int i=21;i<30;i++)m.sample(i,101+i, i,1);
+        assertTrue(Math.hypot(m.x,m.z)<=.360001);
+    }
+}
